FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -tags nodynamic -trimpath -ldflags="-s -w" -o /out/chatgpt2api ./cmd/chatgpt2api

FROM alpine:3.22
RUN apk add --no-cache ca-certificates chromium tzdata \
    && adduser -D -H -u 10001 app
WORKDIR /app
COPY --from=build /out/chatgpt2api /usr/local/bin/chatgpt2api
RUN mkdir -p /app/data && chown -R app:app /app
USER app
EXPOSE 3000
VOLUME ["/app/data"]
ENTRYPOINT ["chatgpt2api"]
CMD ["-config", "/app/config.yaml"]
